  "source": "import 'dart:collection';\nimport 'dart:convert';\nimport 'package:dart_csp/dart_csp.dart';\nFuture<void> main() async {\n  final allowed = HashSet<int>(equals: (a,b) => a.abs()==b.abs(), hashCode: (a)=>a.abs().hashCode)..add(1);\n  final base = Problem()..addVariable('x', [-1,1])..addAtomClause([AtomEq('x',-1)]);\n  final atomic = IncrementalSolver(base)..assumeInSet('x',allowed);\n  final captured = UnmodifiableSetView<int>(allowed.toSet());\n  final predicate = IncrementalSolver(base)..assumePredicate(['x'], (m)=>captured.contains(m['x']));\n  final atomicResult = await atomic.solve();\n  allowed..clear()..add(2);\n  final predicateResult = await predicate.solve();\n  final warmPredicateResult = await predicate.solveWarm();\n  print(jsonEncode({'atomic':atomicResult,'predicate_snapshot':predicateResult,'warm_predicate_snapshot':warmPredicateResult}));\n}\n",
